# Kairos (Minara Cloud). Key must belong to a Kairos-enabled group.
KAIROS_API_KEY=
# KAIROS_BASE_URL=https://minara.cloud

# Bybit TESTNET keys (https://testnet.bybit.com/app/user/api-management)
# Permissions: Contract -> Orders + Positions. NO withdraw.
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Markets / cadence
CTB_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,XRPUSDT,DOGEUSDT
CTB_DECISION_TF=5
CTB_HORIZON_BARS=24

# Start observe-only; flip to 1 (or use the dashboard toggle) to place testnet orders
CTB_TRADING_ENABLED=0
CTB_RISK_PER_TRADE_PCT=0.5
CTB_MAX_LEVERAGE=3
CTB_MAX_POSITIONS=3
